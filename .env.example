DATABASE_URL=postgres://maxihabana:maxihabana@localhost:5432/maxihabana
TEST_DATABASE_URL=postgres://maxihabana:maxihabana@localhost:5432/maxihabana_test
PORT=3000

# Storefront Clerk instance (customers, providers, staff)
CLERK_PUBLISHABLE_KEY=pk_test_storefront
CLERK_SECRET_KEY=sk_test_storefront

# Back-office Clerk instance (admin users only)
CLERK_BACKOFFICE_SECRET_KEY=sk_test_backoffice

# Clerk webhook signing secret for the storefront instance
CLERK_WEBHOOK_SECRET=whsec_

# Clerk webhook signing secret for the back-office instance
CLERK_BACKOFFICE_WEBHOOK_SECRET=whsec_

# Dev-only fallback when Clerk keys are not configured
CLERK_JWT_SECRET=change-me-in-production
CLERK_INVITATION_REDIRECT_URL=http://localhost:3000/invitation

# Auth provider selection. When true, the MockAuthProvider is used and Bearer
# tokens shaped `mock:<clerkId>` authenticate as the user with that clerkId —
# no Clerk secret required. Use for local dev and e2e; keep false in real envs.
MOCK_AUTH_ENABLED=false

# Notifications. When true (default), invitation emails are delegated to Clerk.
# Set to false to suppress outbound notifications (local/e2e).
NOTIFICATIONS_ENABLED=true

# CORS (read by configuration.ts). Comma-separated allow-list.
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true

# Object storage driver: 's3' (default; MinIO locally / AWS S3) or 'cloudinary'.
# Leave unset for local dev -> s3 -> MinIO. Deployed envs set STORAGE_DRIVER=cloudinary.
STORAGE_DRIVER=s3
# Cloudinary (used only when STORAGE_DRIVER=cloudinary). The SDK reads this one var.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# S3-compatible object storage for image uploads. Defaults below target the
# local MinIO from docker-compose.dev.yml. For AWS S3, drop S3_ENDPOINT /
# S3_FORCE_PATH_STYLE, set the real region/bucket/keys, and point S3_PUBLIC_URL
# at the bucket or CDN.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=maxihabana
S3_ACCESS_KEY_ID=maxihabana
S3_SECRET_ACCESS_KEY=maxihabana
S3_FORCE_PATH_STYLE=true
# Base URL used to build the stored public URL. Defaults to S3_ENDPOINT/S3_BUCKET.
S3_PUBLIC_URL=http://localhost:9002/maxihabana

# ---------------------------------------------------------------------------
# Payment gateways. Credentials live here; which methods the storefront offers
# is an admin decision (payment_methods table / back-office). A gateway with no
# credentials in this environment cannot be enabled.
# ---------------------------------------------------------------------------

# Public base URL of THIS api, used for gateway callbacks. Must be reachable
# from the gateway's servers — in local development, a tunnel
# (`cloudflared tunnel --url http://localhost:3000`), not 127.0.0.1.
PUBLIC_API_URL=

# Mi Billetera (crypto deposits)
MIBI_KEY_ID=asd
MIBI_SECRET_KEY=asd
MIBI_WEBHOOK_SECRET=
MIBI_API_BASE=https://mibilletera.cu
# Settlement currency; must match a receiving account bound to the merchant
# payment account at Mi Billetera (else charges 400 with "No active receiving
# account is bound for currency ...").
MIBI_CURRENCY=USD

# Tropipay (hosted card payment links)
TROPIPAY_CLIENT_ID=
TROPIPAY_CLIENT_SECRET=
# Development hits tropipay-dev.herokuapp.com (sandbox credentials);
# Production charges the real account.
TROPIPAY_ENV=Development
# EUR or USD only — anything else is rejected with an opaque 400.
TROPIPAY_CURRENCY=USD

# Unpaid orders release their stock after these windows. Gateway orders are
# measured from the newest payment attempt (the customer is paying right now);
# manual ones wait on an admin, so they get far longer.
ORDER_EXPIRY_GATEWAY_MINUTES=30
ORDER_EXPIRY_MANUAL_HOURS=24
# Shared secret for POST /api/internal/orders/expire, called by the scheduled
# job. Unset disables the route entirely (it fails closed).
CRON_SECRET=

# Storefront cache invalidation (optional). When both are set, taxonomy and
# coverage writes POST {STOREFRONT_URL}/api/revalidate so the Next.js storefront
# refreshes its cached data immediately instead of waiting out the TTL.
STOREFRONT_URL=http://localhost:3001
STOREFRONT_REVALIDATE_SECRET=dev-revalidate-secret

# Rate limiting (MxH-0066). Default ON (120/min per client). Uncomment ONLY on a
# local machine: every local app shares 127.0.0.1's bucket and normal dev traffic
# trips the limit. NEVER set this in a deployed environment. Left COMMENTED in the
# template on purpose, so a copied .env never ships with the limiter disabled.
# THROTTLE_DISABLED=true

# Platform email replies for the contact inbox (Resend). Both unset until the
# Resend account exists: the feature stays fail-closed (503) and the admin UI
# keeps its send button disabled.
# RESEND_API_KEY=
# RESEND_FROM=Maxi <soporte@maxihabana.com>
